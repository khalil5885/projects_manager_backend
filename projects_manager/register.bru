meta {
  name: register
  type: http
  seq: 1
}

post {
  url: 127.0.0.1:8000/register
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  X-Requested-With: XMLHttpRequest
  Content-Type: application/json
}

body:json {
  {
    "name": "Khalil Admin",
    "email": "khalil@gmail.com",
    "password": "password123",
    "password_confirmation": "password123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
